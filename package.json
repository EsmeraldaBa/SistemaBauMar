{
  "name": "baumar-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k \"pnpm run server:dev\" \"pnpm run client:dev\"",
    "server:dev": "node --watch-path=server/src server/src/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test",
    "start": "node server/src/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.63.5"
  }
}
